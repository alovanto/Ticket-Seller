# Copy file này thành .env rồi điền giá trị thật. File .env KHÔNG được commit.
# Mật khẩu: ít nhất 16 ký tự, 2 mật khẩu phải KHÁC nhau. API từ chối chạy nếu còn để mẫu.

# User ADMIN (chủ các bảng) — chỉ dùng cho docker-compose và db:migrate/seed/reset
POSTGRES_USER=ticket
POSTGRES_PASSWORD=doi_mat_khau_admin_o_day
POSTGRES_DB=ticket_seller
POSTGRES_PORT=5432

# User "app" (quyền tối thiểu) — API server dùng. db:migrate tự đặt mật khẩu này vào DB.
APP_DB_PASSWORD=doi_mat_khau_app_o_day
# Không bắt buộc: máy chạy Postgres (mặc định 127.0.0.1)
# POSTGRES_HOST=127.0.0.1

# Không bắt buộc: địa chỉ API server lắng nghe (mặc định 127.0.0.1:3000)
# HOST=127.0.0.1
# PORT=3000
